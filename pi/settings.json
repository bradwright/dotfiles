{
  "defaultThinkingLevel": "xhigh",
  "theme": "solarized-dark",
  "externalEditor": "nvim",
  "showHardwareCursor": true,
  "editorPaddingX": 0,
  "collapseChangelog": true,
  "doubleEscapeAction": "none",
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 10000
  },
  "terminal": {
    "showImages": false,
    "clearOnShrink": false,
    "showTerminalProgress": true
  },
  "images": {
    "blockImages": true
  },
  "retry": {
    "enabled": true,
    "maxRetries": 2,
    "baseDelayMs": 1000
  },
  "enabledModels": [
    "gpt-5.6-luna",
    "gpt-5.6-sol",
    "gpt-5.5",
    "gpt-5.3-codex"
  ],
  "hideThinkingBlock": true,
  "quietStartup": true,
  "packages": []
}
